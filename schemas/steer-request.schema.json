{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steer-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 20000,
      "default": ""
    },
    "attachments": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "attachment.schema.json"
      },
      "default": []
    },
    "mode": {
      "type": "string",
      "enum": [
        "next",
        "immediate"
      ],
      "default": "next"
    }
  }
}