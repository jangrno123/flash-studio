{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "title": "스킬 메타데이터 (SKILL.md 프런트매터를 파싱한 결과)",
  "type": "object",
  "required": ["name", "description", "source", "dir"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9가-힣][A-Za-z0-9가-힣 _.:-]{0,79}$" },
    "description": { "type": "string", "maxLength": 8000 },
    "source": { "type": "string", "enum": ["local", "external"] },
    "dir": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "$defs": {
    "updateRequest": {
      "type": "object",
      "required": ["raw", "expectedRaw"],
      "additionalProperties": false,
      "properties": {
        "raw": { "type": "string", "minLength": 1, "maxLength": 500000 },
        "expectedRaw": { "type": "string", "minLength": 1, "maxLength": 500000 }
      }
    },
    "createRequest": {
      "type": "object",
      "required": ["name", "description", "body"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500000 }
      }
    }
  }
}
