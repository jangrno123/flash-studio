{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider.schema.json",
  "title": "LLM 공급자 (OpenAI 호환 엔드포인트)",
  "type": "object",
  "required": ["id", "name", "baseUrl", "models"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "kind": { "type": "string", "enum": ["openai-compatible"], "default": "openai-compatible" },
    "baseUrl": { "type": "string", "pattern": "^https?://" },
    "apiKey": { "type": "string", "default": "", "description": "직접 입력한 키. 비어 있으면 apiKeyEnv 환경변수를 사용" },
    "apiKeyEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$|^$", "default": "" },
    "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } },
    "thinkingStyle": {
      "type": "string",
      "enum": ["thinking_object", "enable_thinking", "none"],
      "default": "thinking_object",
      "description": "thinking_object: {thinking:{type:enabled|disabled}} (Ark·DeepSeek), enable_thinking: {enable_thinking:bool}, none: 전송 안 함"
    },
    "extraBody": { "type": "object", "default": {} },
    "headers": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200, "description": "API에 보낼 모델 ID 또는 엔드포인트 ID(ep-...)" },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "vision": { "type": "boolean", "default": false },
        "tools": { "type": "boolean", "default": true },
        "reasoning": { "type": "boolean", "default": true },
        "contextWindow": { "type": ["integer", "null"], "minimum": 1, "default": null }
      }
    }
  }
}
