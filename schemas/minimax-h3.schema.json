{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"minimax-h3.schema.json",
  "$defs":{
    "project":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,100}$"},
    "minimax_h3_status":{"type":"object","additionalProperties":false,"properties":{"project_id":{"$ref":"#/$defs/project"},"discover_projects":{"type":"boolean"}}},
    "minimax_h3_runtime":{"type":"object","additionalProperties":false,"properties":{"project_id":{"$ref":"#/$defs/project"},"plan_only":{"type":"boolean"},"hash_models":{"type":"boolean"}}},
    "minimax_h3_jobs":{"type":"object","additionalProperties":false,"required":["project_id","job_ids"],"properties":{"project_id":{"$ref":"#/$defs/project"},"job_ids":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"$ref":"#/$defs/project"}}}},
    "minimax_h3_power":{"type":"object","additionalProperties":false,"required":["action"],"properties":{"action":{"type":"string","enum":["plan_start","start_prepare","bind_project","start_services","plan_stop","stop"]},"project_id":{"$ref":"#/$defs/project"},"expected_project_id":{"$ref":"#/$defs/project"},"acknowledge_boot_autostart":{"type":"boolean"}}}
  }
}
